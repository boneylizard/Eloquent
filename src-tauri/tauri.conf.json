{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirid",
  "version": "1.0.8",
  "identifier": "ai.mirid.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run release:build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Mirid",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss:; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https:; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:* http://localhost:* https:; object-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4RDQ2MjU3QjAzMkYxNDYKUldSRzhUS3dWMkxVdUFhSVBVL2NJaDUrdHkzNmM3OVNESXVIdFhjTEYrSm5FSkZpRTNnRTRudEEK",
      "endpoints": [
        "https://github.com/boneylizard/Eloquent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
