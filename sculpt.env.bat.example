@echo off
REM Copy this file to sculpt.env.bat and edit paths for your machine.
REM run.bat automatically calls sculpt.env.bat before starting the backend.

REM --- Required for full pipeline (UVR + Applio + normalize) ---
REM Folder that contains Applio's core.py (NOT the LiangLocal venv)
set APPLIO_ROOT=C:\Tools\Applio
set APPLIO_PYTHON=C:\Tools\Applio\.venv\Scripts\python.exe
set APPLIO_DEFAULT_PTH=C:\Tools\Applio\logs\MyVoice\MyVoice.pth
set APPLIO_DEFAULT_INDEX=C:\Tools\Applio\logs\MyVoice\added_IVF1024_Flat.index

REM --- Optional: second model for "Target accent" in the UI ---
REM set APPLIO_ACCENT_PTH=C:\Tools\Applio\logs\Accent\Accent.pth
REM set APPLIO_ACCENT_INDEX=C:\Tools\Applio\logs\Accent\added_IVF1024_Flat.index

REM --- UVR vocal isolation (uses LiangLocal venv if you installed audio-separator there) ---
set AUDIO_SEPARATOR_BIN=%~dp0venv\Scripts\audio-separator.exe

REM --- ffmpeg (usually on PATH already) ---
set FFMPEG_BIN=ffmpeg

REM --- Optional ---
REM set VOICE_SCULPT_GPU_ID=0
